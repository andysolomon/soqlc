{
  "name": "soqlc",
  "version": "0.1.0",
  "description": "Generate type-safe TypeScript code from SOQL queries. SOQL-flavored sqlc.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "soqlc": "./bin/soqlc.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "soqlc": "tsx src/cli/index.ts",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "chevrotain": "^11.0.3",
    "commander": "^12.1.0",
    "glob": "^10.4.5",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.7.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
